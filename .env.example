# Environment configuration for the CodeLens backend. Copy to .env and adjust.

# Where the index lives (one SQLite file). Default: ~/.codelens
CODELENS_DB_PATH=~/.codelens

# Ollama server address
OLLAMA_HOST=http://localhost:11434

# Embedding model (nomic-embed-text: 768-dim vectors, ~274 MB).
# Changing it drops stored vectors; they are recomputed on the next index.
EMBED_MODEL=nomic-embed-text

# Model for "Explain" mode (ollama pull <model> first)
EXPLAIN_MODEL=mistral

# Files larger than this many bytes are skipped
MAX_FILE_BYTES=524288

# Chunks embedded per Ollama request
EMBED_BATCH_SIZE=32

# Set to 0 to use the numpy vector backend even when sqlite-vec is available
CODELENS_USE_SQLITE_VEC=1
